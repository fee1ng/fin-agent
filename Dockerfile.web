ARG PYTHON_IMAGE=python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54
ARG NODE_IMAGE=node:24-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
FROM ${PYTHON_IMAGE} AS backend
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TZ=Asia/Shanghai XDG_CONFIG_HOME=/tmp/config
WORKDIR /app
COPY requirements-web.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements-web.lock && pip check
COPY fin_agent ./fin_agent
RUN useradd --uid 10001 --create-home app && mkdir /data && chown app:app /data
USER 10001:10001
VOLUME ["/data"]
ENTRYPOINT ["python", "-m", "fin_agent.web"]

FROM ${NODE_IMAGE} AS frontend-build
WORKDIR /app
RUN npm install --global pnpm@11.25.0
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml frontend/.npmrc ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build

FROM ${NGINX_IMAGE} AS frontend
COPY --from=frontend-build /app/dist /usr/share/nginx/html
COPY deploy/web/nginx.conf /etc/nginx/nginx.conf
COPY deploy/web/proxy.conf /etc/nginx/fin-proxy.conf
EXPOSE 8443
