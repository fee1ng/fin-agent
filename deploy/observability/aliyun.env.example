# Copy to .local/observability.env (gitignored). Never commit real credentials.
FIN_AGENT_OBSERVABILITY=true
OTEL_SERVICE_NAME=fin-agent-local
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
# Copy the PUBLIC HTTP OTLP base endpoint from the Cloud Monitor console.
# Do not append /v1/traces to this shared base URL.
OTEL_EXPORTER_OTLP_ENDPOINT=https://PROJECT.REGION.log.aliyuncs.com/apm/trace/opentelemetry
OTEL_EXPORTER_OTLP_HEADERS=x-arms-license-key=REPLACE_ME,x-arms-project=REPLACE_ME,x-cms-workspace=REPLACE_ME
# Traces already contain token usage. Avoid per-run resource metric cardinality
# until a metrics aggregation policy is configured. Set otlp to enable metrics.
OTEL_METRICS_EXPORTER=none
# Content capture is forced off by the finance adapter, including when another
# tool sets OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT.
